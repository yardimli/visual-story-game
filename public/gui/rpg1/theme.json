{
  "schema_version": 1,
  "id": "rpg1",
  "label": "RPG & MMO X",
  "asset_root": ".",
  "renderer": "png",
  "fallback_theme": "text",
  "resize_policy": "stretch_to_text_bounds",
  "components": {
    "dialogue": {
      "render": "stretch_layers",
      "layers": [],
      "text_color": "#ded6ce",
      "content_padding_px": [
        32,
        64,
        28,
        64
      ],
      "background_color": "#21191e",
      "frame_border": "2px solid #806747",
      "header_color": "#30212e",
      "box_shadow": "0 0 0 3px #30292a, 0 12px 24px rgba(0,0,0,0.5)",
      "action_gap_px": 16,
      "corner_decoration": {
        "file": "Textures/Windows/Window/Window_Tribal.png",
        "rect": [
          0,
          0,
          1,
          1
        ],
        "size_px": 36,
        "height_px": 52,
        "tint": "#886c46"
      }
    },
    "scene_introduction": {
      "same_as": "dialogue"
    },
    "inventory_dialogue": {
      "same_as": "dialogue"
    },
    "choice_button": {
      "render": "stretch_layers",
      "text_color": "#241e26",
      "content_padding_px": [
        10,
        18,
        10,
        18
      ],
      "min_height_px": 44,
      "width": "text_content",
      "states": {
        "normal": {
          "layers": [
            {
              "file": "Textures/Buttons/BR_Large_Background.png",
              "rect": [
                0,
                0,
                1,
                1
              ]
            }
          ]
        },
        "hover": {
          "layers": [
            {
              "file": "Textures/Buttons/BR_Large_Background.png",
              "rect": [
                0,
                0,
                1,
                1
              ]
            },
            {
              "file": "Textures/Buttons/BR_Large_Hover.png",
              "rect": [
                0,
                0,
                1,
                1
              ]
            }
          ],
          "css": {}
        },
        "focus": {
          "same_as": "hover"
        },
        "pressed": {
          "layers": [
            {
              "file": "Textures/Buttons/BR_Large_Background.png",
              "rect": [
                0,
                0,
                1,
                1
              ]
            }
          ],
          "css": {
            "filter": "brightness(0.8)"
          }
        },
        "disabled": {
          "same_as": "normal",
          "css": {
            "opacity": 0.45
          }
        }
      }
    },
    "close_button": {
      "same_as": "choice_button",
      "label": "Close"
    },
    "selection_indicator": {
      "renderer": "existing_css",
      "placement": "outside_left",
      "reserved_space_px": 24
    },
    "inventory_controls": {
      "renderer": "existing_css"
    },
    "audio_controls": {
      "renderer": "existing_css"
    },
    "scrollbar": {
      "thumb": "#927448",
      "track": "#21191e"
    }
  },
  "notes": [
    "Many textures are neutral grayscale; use a dark button label unless tinting is added.",
    "Dialog uses the Window tribal corners over a dark plum panel with a straight gold frame and narrow title-free header band.",
    "BR_Large_Frame is a decorative side bracket, not a complete rectangular frame."
  ],
  "assets": [
    {
      "file": "Textures/Buttons/BR_Large_Background.png",
      "width": 586,
      "height": 176,
      "has_alpha_channel": true,
      "sha256": "250f2a313bdf25a58a59e53f4c036c2837adc76796c25f59f3f974f3c500ffaa",
      "usage": "available"
    },
    {
      "file": "Textures/Buttons/BR_Large_Hover.png",
      "width": 432,
      "height": 193,
      "has_alpha_channel": true,
      "sha256": "d8289325d2f8b3bde4ebebd4d770e9a12488126eac1d1304d3722c4dd7b7dc33",
      "usage": "available"
    },
    {
      "file": "Textures/Windows/Window/Window_Tribal.png",
      "width": 98,
      "height": 142,
      "has_alpha_channel": true,
      "sha256": "e99b3ea753a9c96f43c28fc60d2d266188a3b5aa13e562aaf23354467c6f1f6d",
      "usage": "available"
    }
  ]
}
