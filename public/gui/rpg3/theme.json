{
  "schema_version": 1,
  "id": "rpg3",
  "label": "RPG & MMO III",
  "asset_root": ".",
  "renderer": "png",
  "fallback_theme": "text",
  "resize_policy": "stretch_to_text_bounds",
  "components": {
    "dialogue": {
      "render": "stretch_layers",
      "layers": [
        {
          "file": "Textures/Window/Window_Background.png",
          "rect": [
            0,
            0,
            1,
            1
          ],
          "source_crop": [
            15,
            15,
            113,
            113
          ]
        }
      ],
      "text_color": "#f4eee3",
      "content_padding_px": [
        18,
        22,
        18,
        22
      ]
    },
    "scene_introduction": {
      "same_as": "dialogue"
    },
    "inventory_dialogue": {
      "same_as": "dialogue"
    },
    "choice_button": {
      "render": "stretch_layers",
      "text_color": "#f4eee3",
      "content_padding_px": [
        10,
        18,
        10,
        18
      ],
      "min_height_px": 44,
      "width": "text_content",
      "states": {
        "normal": {
          "layers": [
            {
              "file": "Textures/Buttons/Rectangular/Small/Buttom_RS_Foreground_Yellow.png",
              "rect": [
                0,
                0,
                1,
                1
              ]
            }
          ]
        },
        "hover": {
          "layers": [
            {
              "file": "Textures/Buttons/Rectangular/Small/Buttom_RS_Foreground_Yellow.png",
              "rect": [
                0,
                0,
                1,
                1
              ]
            },
            {
              "file": "Textures/Buttons/Rectangular/Small/Buttom_RS_Hover_Yellow.png",
              "rect": [
                0,
                0,
                1,
                1
              ]
            }
          ],
          "css": {}
        },
        "focus": {
          "same_as": "hover"
        },
        "pressed": {
          "layers": [
            {
              "file": "Textures/Buttons/Rectangular/Small/Buttom_RS_Foreground_Yellow.png",
              "rect": [
                0,
                0,
                1,
                1
              ]
            }
          ],
          "css": {
            "filter": "brightness(0.8)"
          }
        },
        "disabled": {
          "same_as": "normal",
          "css": {
            "opacity": 0.45
          }
        }
      }
    },
    "close_button": {
      "same_as": "choice_button",
      "label": "Close"
    },
    "selection_indicator": {
      "renderer": "existing_css",
      "placement": "outside_left",
      "reserved_space_px": 24
    },
    "inventory_controls": {
      "renderer": "existing_css"
    },
    "audio_controls": {
      "renderer": "existing_css"
    }
  },
  "notes": [
    "The supplied filename spells Buttom, preserved intentionally.",
    "Small colored foregrounds contain the full face/frame; matching hover artwork replaces that face at the same bounds.",
    "No small-button pressed PNG exists; darkening normal is the explicit fallback.",
    "Window source crop removes transparent shadow padding so text stays inside the visible frame."
  ],
  "assets": [
