        18
      ],
      "min_height_px": 44,
      "width": "text_content",
      "states": {
        "normal": {
          "layers": [
            {
              "file": "extracted/button-normal.png",
              "rect": [
                0,
                0,
                1,
                1
              ]
            }
          ]
        },
