          "layers": [
            {
              "file": "extracted/button-hover.png",
              "rect": [
                0,
                0,
                1,
                1
              ]
            }
          ]
        },
        "focus": {
          "same_as": "hover"
        },
        "pressed": {
          "layers": [
            {
              "file": "extracted/button-normal.png",
              "rect": [
                0,
                0,
                1,
                1
              ]
            }
          ],
          "css": {
            "filter": "brightness(0.8)"
          }
        },
        "disabled": {
          "same_as": "normal",
          "css": {
            "opacity": 0.45
          }
        }
      }
    },
    "close_button": {
      "same_as": "choice_button",
      "label": "Close"
    },
    "selection_indicator": {
      "renderer": "existing_css",
      "placement": "outside_left",
      "reserved_space_px": 24
    },
    "inventory_controls": {
      "renderer": "existing_css"
    },
    "audio_controls": {
      "renderer": "existing_css"
    }
  },
  "notes": [
    "Only pack without exported PNG components. Runtime crops are reconstructed from the opaque preview; raw labelled crops are reference-only."
